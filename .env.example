# ── Banco de dados PostgreSQL do Supabase ───────────────────────────────
# No painel do Supabase: Project Settings > Database > Connection string
#   DATABASE_URL -> aba "Transaction" (porta 6543, com pgbouncer=true) — usada pela aplicação
#   DIRECT_URL   -> aba "Session" / "Direct connection" (porta 5432) — usada só para migrações
DATABASE_URL="postgresql://postgres.xxxxxxxx:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# ── Supabase Auth ────────────────────────────────────────────────────────
# No painel do Supabase: Project Settings > API
#   NEXT_PUBLIC_SUPABASE_URL              -> campo "Project URL"
#   NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY  -> campo "anon" / "publishable" key
#   SUPABASE_SERVICE_ROLE_KEY             -> campo "service_role" key (SECRETA — nunca exponha
#                                             no navegador; usada só no seed e em rotas admin)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Pagamento PIX (opcional) ─────────────────────────────────────────────
# Sem essa chave, o checkout roda em modo simulado (para testes).
# Crie a sua em https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_URL="https://seudominio.vercel.app/api/webhooks/mercadopago"

# ── Seed ──────────────────────────────────────────────────────────────────
# Senha da conta admin criada por `npm run db:seed` (opcional — padrão: TrocarSenha123!)
SEED_ADMIN_PASSWORD="TrocarSenha123!"
