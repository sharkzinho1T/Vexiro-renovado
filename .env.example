# Banco de dados PostgreSQL — Supabase (crie um projeto gratuito em https://supabase.com)
#
# No painel do Supabase: Project Settings > Database > Connection string
# 1) DATABASE_URL  -> aba "Transaction" (porta 6543, com "pgbouncer=true"), usada pela aplicação
# 2) DIRECT_URL    -> aba "Session"/"Direct connection" (porta 5432), usada só para migrações
DATABASE_URL="postgresql://postgres.xxxxxxxx:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Gerado com: openssl rand -base64 32
NEXTAUTH_SECRET="troque-por-um-valor-aleatorio-seguro"
NEXTAUTH_URL="http://localhost:3000"

# Opcional: sem essa chave, o checkout PIX roda em modo simulado (para testes).
# Crie a sua em https://www.mercadopago.com.br/developers
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_WEBHOOK_URL="https://seudominio.vercel.app/api/webhooks/mercadopago"

# Senha da conta admin criada pelo seed (opcional — padrão: TrocarSenha123!)
SEED_ADMIN_PASSWORD="TrocarSenha123!"
